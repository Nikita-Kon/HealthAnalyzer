# mock      → built-in mock data (same JSON contract as the backend)
# /api/v1   → FastAPI on localhost:8000 via the Vite dev proxy
#             (or the deployed one: API_PROXY=https://demo.nikitak.dev VITE_API_URL=/api/v1 npm run dev)
# https://… → deployed backend
VITE_API_URL=/api/v1
API_PROXY=http://127.0.0.1:8000
